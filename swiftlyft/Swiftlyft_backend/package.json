{
  "name": "swift-lyft-auth-api",
  "version": "1.0.0",
  "description": "SwiftLyft Backend API with MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo Backend has no compile step; build completed.",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:setup": "node scripts/setupDatabase.js",
    "db:setup:all": "node scripts/orchestrateDatabase.js --all",
    "db:setup:seed": "node scripts/setupDatabase.js --sample-data",
    "db:migrate": "node scripts/migrateDatabase.js",
    "db:indexes": "node scripts/createIndexes.js",
    "db:health": "node scripts/setupDatabase.js --no-seed --no-indexes --no-validate",
    "db:validate": "node scripts/orchestrateDatabase.js --all --skip-setup --skip-seed",
    "payment:setup": "node scripts/setupPaymentsDatabase.js",
    "payment:migrate": "node scripts/migratePaymentDatabase.js",
    "payment:test": "jest tests/payments.test.js",
    "location:setup": "node scripts/setupLocationDatabase.js",
    "location:test": "jest tests/location.test.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --check \"**/*.{js,json}\"",
    "format:fix": "prettier --write \"**/*.{js,json}\""
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "authentication",
    "api",
    "swiftlyft"
  ],
  "author": "SwiftLyft Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-geocoder": "^4.2.0",
    "nodemailer": "^6.9.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
