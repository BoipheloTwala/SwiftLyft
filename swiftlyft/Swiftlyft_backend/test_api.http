# SwiftLyft Authentication API Testing
# Use this file with REST Client extension in VS Code or similar tools

### Variables
@baseUrl = http://localhost:3000/api
@email = test@example.com
@password = TestPassword123
@accessToken = your_access_token_here
@refreshToken = your_refresh_token_here
@userId = your_user_id_here
@bookingId = your_booking_id_here
@paymentMethodId = your_payment_method_id_here
@paymentId = your_payment_id_here
@driverId = your_driver_id_here
@locationId = your_location_id_here

### 1. Health Check
GET {{baseUrl}}/health

### 2. Register New User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "Test User",
  "phoneNumber": "+27123456789"
}

### 3. Login User
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### 4. Get Current User Profile (Protected Route)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### 5. Get User Profile
GET {{baseUrl}}/users/profile
Authorization: Bearer {{accessToken}}

### 6. Update User Profile
PUT {{baseUrl}}/users/profile
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Updated Test User",
  "phoneNumber": "+27987654321"
}

### 7. Upload Profile Picture
POST {{baseUrl}}/users/upload-avatar
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "profileImageUrl": "https://example.com/avatar.jpg"
}

### 8. Add Saved Address
POST {{baseUrl}}/users/addresses
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "label": "Home",
  "address": "123 Main Street, Johannesburg, South Africa",
  "coordinates": {
    "latitude": -26.2041,
    "longitude": 28.0473
  },
  "isDefault": true
}

### 9. Get Saved Addresses
GET {{baseUrl}}/users/addresses
Authorization: Bearer {{accessToken}}

### 10. Get Loyalty Information
GET {{baseUrl}}/users/loyalty
Authorization: Bearer {{accessToken}}

### 11. Get Referral Information
GET {{baseUrl}}/users/referral
Authorization: Bearer {{accessToken}}

### 12. Get User Statistics
GET {{baseUrl}}/users/stats
Authorization: Bearer {{accessToken}}

### 13. Change Password
POST {{baseUrl}}/auth/change-password
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "currentPassword": "{{password}}",
  "newPassword": "NewPassword123"
}

### 14. Refresh Token
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 15. Forgot Password
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "{{email}}"
}

### 16. Reset Password (use token from forgot password response)
POST {{baseUrl}}/auth/reset-password/RESET_TOKEN_HERE
Content-Type: application/json

{
  "password": "NewResetPassword123"
}

### 17. Logout
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "refreshToken": "{{refreshToken}}"
}

### 18. Logout from All Devices
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer {{accessToken}}

### 19. Delete Account (be careful with this one!)
DELETE {{baseUrl}}/users/account
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "password": "{{password}}"
}

###############################################
# Error Testing Scenarios
###############################################

### Test Invalid Email Format
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "TestPassword123",
  "name": "Test User"
}

### Test Weak Password
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "weak@example.com",
  "password": "123",
  "name": "Test User"
}

### Test Login with Wrong Password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "WrongPassword"
}

### Test Access Protected Route Without Token
GET {{baseUrl}}/users/profile

### Test Access with Invalid Token
GET {{baseUrl}}/users/profile
Authorization: Bearer invalid_token_here

###############################################
# Vehicle Management API Testing
###############################################

### 1. Get Available Vehicles by Location
GET {{baseUrl}}/vehicles/available?latitude=-26.2041&longitude=28.0473&maxDistance=10000

### 2. Get Available Vehicles with Category Filter
GET {{baseUrl}}/vehicles/available?latitude=-26.2041&longitude=28.0473&category=sedan&passengerCount=4

### 3. Get Available Vehicles with Features Filter
GET {{baseUrl}}/vehicles/available?latitude=-26.2041&longitude=28.0473&features=wifi,airConditioning

### 4. Get Vehicle Details by ID
GET {{baseUrl}}/vehicles/VH001

### 5. Get Vehicle Categories
GET {{baseUrl}}/vehicles/categories

### 6. Search Vehicles by Criteria
GET {{baseUrl}}/vehicles/search?latitude=-26.2041&longitude=28.0473&category=sedan&passengerCount=4&features=wifi

### 7. Search Vehicles by Make and Model
GET {{baseUrl}}/vehicles/search?make=Toyota&model=Camry

### 8. Search Vehicles by Price Range
GET {{baseUrl}}/vehicles/search?priceMin=20&priceMax=50

### 9. Check Vehicle Availability
GET {{baseUrl}}/vehicles/VH001/availability

### 10. Update Vehicle Status (Requires Authentication)
PUT {{baseUrl}}/vehicles/VH001/status
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "status": "busy"
}

### 11. Update Vehicle Availability
PUT {{baseUrl}}/vehicles/VH001/status
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "isAvailable": false,
  "availableUntil": "2024-12-31T23:59:59.000Z"
}

### 12. Update Vehicle Working Hours
PUT {{baseUrl}}/vehicles/VH001/status
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "workingHours": {
    "start": "06:00",
    "end": "22:00"
  },
  "operatingDays": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
}

### 13. Get Vehicles by Driver ID
GET {{baseUrl}}/vehicles/driver/DRV001

### 14. Get Vehicle Statistics
GET {{baseUrl}}/vehicles/stats

### 15. Create New Vehicle (Requires Driver Authentication) - Frontend Compatible
POST {{baseUrl}}/vehicles
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Mercedes S-Class",
  "description": "Ultimate luxury sedan with premium features",
  "make": "Mercedes",
  "model": "S-Class",
  "year": 2023,
  "color": "Obsidian Black",
