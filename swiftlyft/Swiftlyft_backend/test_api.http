  "seatingCapacity": 4,
  "basePrice": 1200,
  "imageUrl": "https://example.com/mercedes_s_class.jpg",
  "imageGallery": [
    "https://example.com/mercedes_s_class_1.jpg",
    "https://example.com/mercedes_s_class_2.jpg",
    "https://example.com/mercedes_s_class_3.jpg"
