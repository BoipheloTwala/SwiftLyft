# ========================================
# PAYMENT PROCESSING APIs
# ========================================

### Process Payment
POST {{baseUrl}}/payments/process
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "bookingId": "{{bookingId}}",
  "paymentMethodId": "{{paymentMethodId}}",
  "amount": 150.00,
  "description": "Payment for ride booking",
  "metadata": {
    "source": "mobile_app",
    "version": "1.0.0"
  }
}

### Get User Payment Methods
GET {{baseUrl}}/payments/users/{{userId}}/payment-methods
Authorization: Bearer {{accessToken}}

### Add Payment Method - Credit Card
POST {{baseUrl}}/payments/users/{{userId}}/payment-methods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "type": "card",
  "cardNumber": "1234567890123456",
  "expiryMonth": "12",
  "expiryYear": "2025",
  "holderName": "Test User",
  "brand": "visa",
  "isDefault": true,
  "encryptedData": "encrypted_card_data_placeholder"
}

### Add Payment Method - Debit Card
POST {{baseUrl}}/payments/users/{{userId}}/payment-methods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "type": "card",
  "cardNumber": "5555555555554444",
  "expiryMonth": "6",
  "expiryYear": "2026",
  "holderName": "Test User",
  "brand": "mastercard",
  "isDefault": false,
  "encryptedData": "encrypted_card_data_placeholder"
}

### Add Payment Method - Digital Wallet
POST {{baseUrl}}/payments/users/{{userId}}/payment-methods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "type": "paypal",
  "isDefault": false,
  "encryptedData": "encrypted_wallet_data_placeholder"
}

### Remove Payment Method
DELETE {{baseUrl}}/payments/payment-methods/{{paymentMethodId}}
Authorization: Bearer {{accessToken}}

### Get User Payment History
GET {{baseUrl}}/payments/users/{{userId}}/payments
Authorization: Bearer {{accessToken}}

### Get User Payment History with Filters
GET {{baseUrl}}/payments/users/{{userId}}/payments?status=completed&limit=10&page=1
Authorization: Bearer {{accessToken}}

### Get User Payment History by Date Range
GET {{baseUrl}}/payments/users/{{userId}}/payments?dateFrom=2024-01-01&dateTo=2024-12-31
Authorization: Bearer {{accessToken}}

### Process Refund - Partial
POST {{baseUrl}}/payments/{{paymentId}}/refund
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "amount": 50.00,
  "reason": "Customer requested partial refund due to service issue"
}

### Process Refund - Full
POST {{baseUrl}}/payments/{{paymentId}}/refund
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "reason": "Customer cancelled booking"
}

### Check Payment Status
GET {{baseUrl}}/payments/{{paymentId}}/status
Authorization: Bearer {{accessToken}}

