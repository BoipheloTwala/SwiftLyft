}

### Test Unauthorized Access to Payment Methods
GET {{baseUrl}}/payments/users/other_user_id/payment-methods
Authorization: Bearer {{accessToken}}

### Test Unauthorized Access to Payment History
GET {{baseUrl}}/payments/users/other_user_id/payments
Authorization: Bearer {{accessToken}}

# ===========================================
# LOCATION & MAPPING APIs
# ===========================================

### 1. Geocode Address (Convert address to coordinates)
POST {{baseUrl}}/location/geocode
Content-Type: application/json

{
  "address": "123 Main Street, Johannesburg, South Africa",
  "saveLocation": false
}

### 2. Geocode Address and Save Location
POST {{baseUrl}}/location/geocode
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "address": "Sandton City, Johannesburg, South Africa",
  "saveLocation": true,
  "type": "pickup",
  "category": "commercial"
}

### 3. Reverse Geocode (Convert coordinates to address)
POST {{baseUrl}}/location/reverse-geocode
Content-Type: application/json

{
  "latitude": -26.2041,
  "longitude": 28.0473,
  "saveLocation": false
}

### 4. Reverse Geocode and Save Location
POST {{baseUrl}}/location/reverse-geocode
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "latitude": -26.2041,
  "longitude": 28.0473,
  "saveLocation": true,
  "type": "dropoff",
  "category": "residential"
}

### 5. Calculate Route Between Two Points
POST {{baseUrl}}/location/route
Content-Type: application/json

{
  "origin": {
    "latitude": -26.2041,
    "longitude": 28.0473
  },
  "destination": {
    "latitude": -26.2141,
    "longitude": 28.0573
  },
  "options": {
    "profile": "driving-car",
    "avoid": ["tolls"],
    "avoidBorders": "none"
  }
}

### 6. Calculate Route with Different Profile
POST {{baseUrl}}/location/route
Content-Type: application/json

{
  "origin": {
    "latitude": -26.2041,
    "longitude": 28.0473
  },
  "destination": {
    "latitude": -26.2141,
    "longitude": 28.0573
  },
  "options": {
    "profile": "cycling-regular",
    "averageSpeed": 15
  }
}

### 7. Search for Places/Addresses
GET {{baseUrl}}/location/places/search?q=Johannesburg&limit=10

### 8. Search Places with Bounds
GET {{baseUrl}}/location/places/search?q=restaurant&limit=5&bounds={"north":-26.0,"south":-26.3,"east":28.2,"west":27.8}

### 9. Find Nearby Places
GET {{baseUrl}}/location/places/nearby?latitude=-26.2041&longitude=28.0473&radius=1000&category=amenity&limit=20

### 10. Find Nearby Restaurants
GET {{baseUrl}}/location/places/nearby?latitude=-26.2041&longitude=28.0473&radius=500&category=restaurant&limit=10

### 11. Check Service Area Coverage
POST {{baseUrl}}/location/service-area
Content-Type: application/json

{
  "latitude": -26.2041,
  "longitude": 28.0473
}

### 12. Check Service Area Outside Coverage
POST {{baseUrl}}/location/service-area
Content-Type: application/json

{
  "latitude": -30.0,
  "longitude": 25.0
}

### 13. Get Driver Real-time Location
GET {{baseUrl}}/drivers/{{driverId}}/location
Authorization: Bearer {{accessToken}}

### 14. Get Driver Location (Admin Access)
GET {{baseUrl}}/drivers/{{driverId}}/location
Authorization: Bearer {{accessToken}}

### 15. Save Custom Location
POST {{baseUrl}}/location/save
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "latitude": -26.2041,
  "longitude": 28.0473,
  "address": {
    "formatted": "My Home Address",
    "streetNumber": "123",
    "streetName": "Main Street",
    "suburb": "Sandton",
    "city": "Johannesburg",
    "state": "Gauteng",
    "country": "South Africa",
    "postcode": "2196"
  },
  "type": "pickup",
  "category": "residential",
  "accuracy": 10,
  "notes": "My home address",
  "tags": ["home", "favorite"]
}

### 16. Get Location History
GET {{baseUrl}}/location/history?limit=20&page=1
Authorization: Bearer {{accessToken}}

### 17. Get Location History by Type
GET {{baseUrl}}/location/history?type=pickup&limit=10
Authorization: Bearer {{accessToken}}

### 18. Find Nearby Saved Locations
GET {{baseUrl}}/location/nearby-saved?latitude=-26.2041&longitude=28.0473&radius=5&limit=20
Authorization: Bearer {{accessToken}}

### 19. Find Nearby Saved Locations by Type
GET {{baseUrl}}/location/nearby-saved?latitude=-26.2041&longitude=28.0473&radius=10&type=pickup&limit=10
Authorization: Bearer {{accessToken}}

### 20. Update Saved Location
PUT {{baseUrl}}/location/{{locationId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "type": "dropoff",
  "category": "commercial",
  "notes": "Updated location notes",
  "tags": ["updated", "work"]
}

### 21. Delete Saved Location
DELETE {{baseUrl}}/location/{{locationId}}
Authorization: Bearer {{accessToken}}

